generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Blog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  category    String   
  imageUrl    String? @default("https://previews.123rf.com/images/tashatuvango/tashatuvango1703/tashatuvango170300860/73927041-my-blog-cartoon-illustration-on-purple-chalkboard-.jpg")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
