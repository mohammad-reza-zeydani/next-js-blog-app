generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("mongodb+srv://blog:mrz2002@blogapp.fhjfq.mongodb.net/")
}

model Blog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  imageUrl  String?
  createdAt DateTime @default(now()) @db.Timestamp
}
